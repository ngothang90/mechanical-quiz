rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "ngothang90@gmail.com";
    }

    function validAttemptCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.employeeCode is string
        && request.resource.data.fullName is string
        && request.resource.data.total == 25
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 25
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100;
    }

    function validPublicCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.employeeCode is string
        && request.resource.data.fullName is string
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 25
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100;
    }

    match /attempts/{attemptId} {
      allow create: if validAttemptCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /publicAttempts/{attemptId} {
      allow create: if validPublicCreate();
      allow read: if signedIn();
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /employees/{employeeCode} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
